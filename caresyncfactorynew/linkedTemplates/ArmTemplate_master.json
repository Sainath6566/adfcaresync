{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "caresyncfactorynew"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncstorageaccnew.dfs.core.windows.net/"
		},
		"LS_Databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1009-062453-mnmxl3oi"
		},
		"LS_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresyncvault2.vault.azure.net/"
		},
		"LS_Postgres_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-dry-forest-b4jopuiw-pooler.c-6.us-east-2.aws.neon.tech"
		},
		"LS_Postgres_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_Postgres_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LS_SQLDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresyncserver2.database.windows.net"
		},
		"LS_SQLDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "caresyncadb"
		},
		"LS_SQLDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sainadh"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "caresyncfactorynew_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_KeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_Databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_Databricks_properties_typeProperties_existingClusterId')]"
					},
					"LS_Postgres_properties_typeProperties_server": {
						"value": "[parameters('LS_Postgres_properties_typeProperties_server')]"
					},
					"LS_Postgres_properties_typeProperties_database": {
						"value": "[parameters('LS_Postgres_properties_typeProperties_database')]"
					},
					"LS_Postgres_properties_typeProperties_username": {
						"value": "[parameters('LS_Postgres_properties_typeProperties_username')]"
					},
					"LS_SQLDB_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLDB_properties_typeProperties_server')]"
					},
					"LS_SQLDB_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLDB_properties_typeProperties_database')]"
					},
					"LS_SQLDB_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLDB_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}